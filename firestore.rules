rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Leaderboard (Ultimate Roster) ----
    // Public read: anyone, logged-out visitors included, can view the global
    // leaderboard. Writes stay locked to the owning user and are validated so
    // inflated stats cannot reach the board.
    match /leaderboard/{userId} {
      allow read: if true;

      allow write: if request.auth != null
        && request.auth.uid == userId
        && validLeaderboardEntry(request.resource.data);
    }

    // ---- Career leaderboard (Ultimate Career) ----
    // ONE DOC PER SAVE SLOT, keyed `{uid}__{slot}`. A player with three careers
    // has three entries and none of them replaces another: the board ranks
    // careers, not accounts. That bounds this collection at three documents per
    // registered user, which is what the field-count and string caps below are
    // sized against.
    //
    // THE PATH IS STILL THE OWNERSHIP PROOF, and no rule parses anything.
    // ownsCareerEntry() rebuilds the three ids this account is allowed to write
    // from request.auth.uid and compares — a membership test against three
    // literal strings, with no split(), no regex and nothing to mis-tokenise.
    // A fourth save slot therefore means re-publishing these rules by hand
    // BEFORE shipping the client, exactly as adding a row field already does.
    //
    // The bare `{uid}` path from before slots is intentionally no longer
    // writable. Those documents are read-only history now; the client deletes
    // its own on the first per-slot publish, and delete is still allowed for
    // them by the same helper's first clause.
    //
    // Two TOP-LEVEL collections, not a parent plus subcollection: deleting a
    // parent document does NOT delete its subcollection in Firestore, so
    // removing an entry from the board would silently orphan the dossier.
    //
    // create plus update, and NOT write: a bare write also covers delete, and
    // on a delete request.resource is null, so calling a validator on it errors
    // and the rule denies. That is the bug the leaderboard block has today,
    // where nobody can take their own entry off the board.
    match /careerBoard/{entryId} {
      allow read: if true;

      allow create, update: if request.auth != null
        && ownsCareerSlot(entryId, request.auth.uid)
        && validCareerRow(request.resource.data);

      allow delete: if request.auth != null
        && ownsCareerEntry(entryId, request.auth.uid);
    }

    // ---- Career dossier ----
    // The full record, fetched ONLY when a board row is opened. The payload is
    // a JSON string because rules cannot iterate a variable-length list: a list
    // bound caps the row COUNT while letting each row carry a huge string. The
    // size of a string is the only hard BYTE bound this language can express.
    //
    // It also carries the HIDDEN flag, which is the only durable board state
    // the client keeps. Hiding a career deletes its ranking row and rewrites
    // this document with hidden:true and an empty blob, so the decision travels
    // between the player's devices without a byte being written to their save.
    match /careerBoardProfiles/{entryId} {
      allow read: if true;

      allow create, update: if request.auth != null
        && ownsCareerSlot(entryId, request.auth.uid)
        && validCareerDossier(request.resource.data);

      allow delete: if request.auth != null
        && ownsCareerEntry(entryId, request.auth.uid);
    }

    // ---- Cloud saves ----
    // Strictly personal: only the owner can read or write their save.
    match /saves/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    // ---- Friendships ----
    // One edge doc per pair, id being the two uids sorted and joined by an
    // underscore. Only the two participants can see or change the edge.
    match /friendships/{pairId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.users;

      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.users
        && request.resource.data.users.size() == 2
        && request.resource.data.requester == request.auth.uid
        && request.resource.data.status == 'pending';

      allow update, delete: if request.auth != null
        && request.auth.uid in resource.data.users;
    }

    // Everything else is denied by default.
  }

  // ---- Leaderboard validation helper ----
  // There is deliberately no totalBE guard here. This file must mirror what is
  // actually PUBLISHED in the Firebase console, and the published rules have
  // never carried one. Both writers already clamp totalBE client-side, so
  // adding a totalBE range check is safe for current builds, but it would deny
  // a cached older client that predates the field, and that failure is
  // swallowed and invisible. Add it only deliberately.
  function validLeaderboardEntry(d) {
    return d.keys().hasAll(['displayName', 'totalPower', 'trophies', 'updatedAt'])
      && d.totalPower is int && d.totalPower >= 0 && d.totalPower <= 145
      && d.trophies is int && d.trophies >= 0 && d.trophies <= 100000
      && d.managerLevel is int && d.managerLevel >= 1 && d.managerLevel <= 1000
      && d.rawPower is int && d.rawPower >= 0 && d.rawPower <= 99
      && d.updatedAt is int
      && d.updatedAt > (request.time.toMillis() - 600000)
      && d.updatedAt <= request.time.toMillis()
      && d.displayName is string && d.displayName.size() <= 64
      && d.teamName is string && d.teamName.size() <= 64;
  }

  // ---- Career board ownership ----
  // Three literal comparisons, built from the caller's own uid. This is NOT a
  // doc-id parse: nothing is split, nothing is matched against a pattern, and
  // no substring of an attacker-supplied id is ever trusted. It is the same
  // guarantee `request.auth.uid == userId` gave before slots existed, restated
  // for the three ids one account may now write.
  //
  // SLOT_IDS in the client is [1, 2, 3]. If that ever grows, this list has to
  // grow FIRST and be published by hand, or every publish from the new slot is
  // denied silently.
  function ownsCareerSlot(entryId, uid) {
    return entryId == uid + '__1'
      || entryId == uid + '__2'
      || entryId == uid + '__3';
  }

  // Delete additionally covers the pre-slot document at the bare uid, so the
  // client can clean up its own legacy entry. Nothing may WRITE that path any
  // more, which is what stops a duplicate row reappearing there.
  function ownsCareerEntry(entryId, uid) {
    return entryId == uid || ownsCareerSlot(entryId, uid);
  }

  // ---- Career board validation ----
  // THESE RULES BOUND WHAT A PUBLISHED DOCUMENT COSTS THE PEOPLE WHO READ IT --
  // its field count and the length of every string in it -- and almost nothing
  // else. Every field is type-checked so nothing unbounded can be smuggled in;
  // only the one field the board actually RANKS on carries a range.
  //
  // This block used to enforce twenty-five numeric ranges, six cross-field
  // rails (years <= age - 12, wins + losses <= games, games <= years * 60 + 60,
  // earnedScore <= years * 4000 + 400, worlds <= years, and a finishedScore
  // derivation), two enums and a ten-minute clock-freshness window -- all
  // mirrored BY HAND into anticheat.js. Every one of those was a way for an
  // honest career to be denied silently and permanently the moment this file
  // and the client disagreed about a single literal, and this file is pasted
  // into the console by hand, so disagreeing is its default state. It bought
  // very little: this is a vanity board for a single-player mode, sanitizeRow()
  // in career/board.js re-clamps every value on READ, and every id is
  // re-resolved locally so no remote string reaches the DOM.
  //
  // What is left cannot drift. `is int` does not go stale when a bound is
  // retuned. A generous string cap cannot deny a legal handle. There is no
  // enum, so ADDING A ROLE OR A REGION NO LONGER NEEDS A RULES DEPLOY -- which
  // is what made the sixth region a two-stage release.
  //
  // Two things are still worth enforcing:
  //   keys().size() is what stops a client stapling a megabyte onto a document
  //     that every reader then downloads fifty times per board load.
  //   earnedScore has an absolute ceiling because it is the ranked field. A
  //     real 24-year career retires around 22000; 70000 is headroom, not a rail.
  //
  // The string caps must never fall BELOW the client's own clamps in
  // CAREER_STR_MAX -- a rules cap tighter than the client's is the silent
  // lockout this rewrite exists to remove. boardCheck asserts that direction.
  function validCareerRow(d) {
    return d.keys().size() <= 25
      && d.v is int && d.slot is int && d.age is int && d.years is int
      && d.ovr is int && d.peakOVR is int && d.peakMMR is int
      && d.games is int && d.wins is int && d.losses is int
      && d.boughtScore is int && d.finishedScore is int
      && d.titles is int && d.worlds is int && d.trophies is int
      && d.updatedAt is int
      && d.earnedScore is int && d.earnedScore >= 0 && d.earnedScore <= 70000
      && d.retired is bool
      && d.hallOfLegends is bool
      && d.careerId is string && d.careerId.size() <= 16
      && d.handle is string && d.handle.size() <= 16
      && d.displayName is string && d.displayName.size() <= 64
      && d.teamId is string && d.teamId.size() <= 32
      && d.role is string && d.role.size() <= 8
      && d.region is string && d.region.size() <= 16;
  }

  // A 24-year career compacts to about 8kb. The client re-parses and re-clamps
  // the blob on read regardless, so this bounds its SIZE and never its contents.
  //
  // THE BLOB MAY BE EMPTY, and the old `size() > 0` is gone deliberately. A
  // hidden career's dossier is rewritten to hidden:true with no blob at all —
  // that is what stops a career the player took off the board leaving a
  // readable copy of itself at a public path — and a minimum length here would
  // deny that write, leaving Hide broken with nothing on screen to say why.
  // The client's sanitizeDossier() already returns null for an empty blob, so
  // an empty one opens nothing rather than rendering a blank career.
  function validCareerDossier(d) {
    return d.keys().size() <= 5
      && d.v is int
      && d.updatedAt is int
      && d.hidden is bool
      && d.careerId is string && d.careerId.size() <= 16
      && d.blob is string && d.blob.size() <= 24000;
  }
}
